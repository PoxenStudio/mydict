# 所有变量均有合理默认值（见下），.env 文件本身是可选的：不提供也能直接启动。
# 需要覆盖时复制本文件为 .env，取消对应行的注释并修改。

# JWT_SECRET=                                  # 留空则首次启动自动生成并持久化到 /data/config/jwt_secret.key
# OPEN_ACCESS_DEFAULT=false                    # 是否允许匿名查询（按 IP 限流）
# ALLOW_REGISTRATION_DEFAULT=true              # 是否允许用户自助注册
# TOKEN_DEFAULT_DAILY_LIMIT=1000               # 新建 Token 的默认每日查询上限
# ANONYMOUS_IP_RATE_LIMIT_PER_MIN=60           # 匿名查询每 IP 每分钟限流
# MAX_UPLOAD_SIZE_MB=512                       # 网页上传词典文件的大小上限
# ENABLE_SCHEDULER=true                        # 统计聚合定时任务开关，仅测试环境需要关闭

# CONFIG_STORAGE_PATH=/data/config
# DICTS_INBOX_PATH=/data/dicts                 # 服务器目录导入的词典源文件目录
# DATABASE_PATH=/data/db/mydict.sqlite3
# DICTIONARY_STORAGE_PATH=/data/dictionaries   # 已导入词典的归档与对外资源目录
# LOG_DIR=/data/logs                           # 运行日志目录，按 5MB/5 份自动滚动
